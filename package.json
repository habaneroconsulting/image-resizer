  "license": "MIT",
  "homepage": "https://habaneroconsulting.github.io/image-resizer",
  "type": "module",
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@fluentui/react": "8.125.8",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@vitejs/plugin-react-swc": "4.3.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "20.1.3",
    "react-gtm-module": "2.0.11",
    "react-image-crop": "11.1.2",
    "react-router-dom": "7.18.4",
    "react-uid": "2.4.0",
    "vite": "8.3.4",
    "vite-plugin-svgr": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-gtm-module": "2.0.4",
    "image-size": "2.0.4",
    "prettier": "3.9.10",
    "source-map-explorer": "2.5.3",
    "typescript": "7.0.2"
  },
  "scripts": {
    "analyze": "vite build --sourcemap && source-map-explorer 'dist/assets/*.js' --html dist/analyze.html",
    "build": "tsc && vite build",
    "docker-test-build": "docker build -t playwright-tests .",
    "docker-test-run": "docker run --rm -v .:/app -v /app/node_modules/ playwright-tests",
    "docker-test": "npm run docker-test-build && npm run docker-test-run",
    "prettier": "prettier ./src/**/* --write",
    "test": "npx playwright test",
    "serve": "vite preview",
    "start": "vite"
  }
}
